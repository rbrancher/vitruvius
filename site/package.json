{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:fixture": "VITRUVIUS_CONTENT=tests/fixture/conteudo astro build --outDir dist-fixture",
    "preview:fixture": "astro preview --outDir dist-fixture",
    "conteudo:validar": "VITRUVIUS_CONTENT=conteudo vitest run tests/conteudo",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots=all",
    "check": "npm run conteudo:validar && npm run typecheck && npm test && npm run build:fixture && npm run test:visual",
    "deploy": "astro build && wrangler pages deploy dist --project-name vitruvius",
    "upload-media": "node --env-file=.env scripts/upload-media.mjs",
    "sync-media": "node --env-file=.env scripts/server-to-r2.mjs",
    "sync-arqtur": "node --env-file=.env scripts/arqtur-images-to-r2.mjs"
  },
  "dependencies": {
    "@pagefind/default-ui": "^1.5.2",
    "astro": "^5.17.1",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@aws-sdk/client-s3": "^3.1033.0",
    "@playwright/test": "1.56.1",
    "mime-types": "^3.0.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.84.0"
  }
}
