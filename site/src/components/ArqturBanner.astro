---
interface Props {
  src: string;
  alt?: string;
}
const { src, alt = 'arquiteturismo' } = Astro.props;
---

<div class="arqtur-banner">
  <img class="arqtur-banner-img" src={src} alt={alt} loading="eager" />
  <span class="arqtur-arrow arqtur-arrow--right">›</span>
  <span class="arqtur-arrow arqtur-arrow--left">‹</span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.arqtur-banner').forEach(banner => {
    const img    = banner.querySelector<HTMLImageElement>('.arqtur-banner-img')!;
    const arrowL = banner.querySelector<HTMLElement>('.arqtur-arrow--left')!;
    const arrowR = banner.querySelector<HTMLElement>('.arqtur-arrow--right')!;
    let panned = false;

    // Arrow fades follow the original (app_magazines.js): only the arrow you
    // can go towards shows, and only while the pointer is over the banner.
    function fade(arrow: HTMLElement, visible: boolean, ms: number) {
      arrow.style.transition = `opacity ${ms}ms`;
      arrow.style.opacity = visible ? '1' : '0';
    }
    const towards = () => (panned ? arrowL : arrowR);

    banner.addEventListener('mouseenter', () => fade(towards(), true, 750));
    banner.addEventListener('mouseleave', () => {
      fade(arrowL, false, 250);
      fade(arrowR, false, 250);
    });
    banner.addEventListener('click', () => {
      panned = !panned;
      // As in the original: slide by the part of the image that doesn't fit.
      const hidden = Math.max(0, img.offsetWidth - banner.offsetWidth);
      img.style.transform = panned ? `translateX(-${hidden}px)` : 'translateX(0)';
      fade(panned ? arrowR : arrowL, false, 250);
      fade(towards(), true, 1500);
    });
  });
</script>
