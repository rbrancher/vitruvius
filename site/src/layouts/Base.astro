---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  magazine?: string;   // sets data-magazine on <body> + renders mag header bar
  editionIdx?: string; // kept for back-compat on read pages (unused in header)
}

const {
  title,
  description = 'Vitruvius — publicações de arquitetura e urbanismo',
  canonicalUrl = Astro.url.href,
  ogImage,
  magazine,
} = Astro.props;

const fullTitle = title === 'Vitruvius' ? title : `${title} — Vitruvius`;
const searchQ = Astro.url.searchParams.get('q') ?? '';

const LABELS: Record<string, string> = {
  arquitextos:    'arquitextos',
  arquiteturismo: 'arquiteturismo',
  drops:          'drops',
  minhacidade:    'minha cidade',
  entrevista:     'entrevista',
  projetos:       'projetos',
  resenhasonline: 'resenhas online',
};
const magLabel = magazine ? (LABELS[magazine] ?? magazine) : null;

const ISSN: Record<string, string> = {
  arquitextos:    '1809-6298',
  arquiteturismo: '1982-9930',
  drops:          '2175-6716',
  minhacidade:    '1982-9922',
  entrevista:     '2175-6708',
  projetos:       '2595-4245',
  resenhasonline: '2175-6694',
};
const magIssn = magazine ? (ISSN[magazine] ?? null) : null;

const isRevistas = Astro.url.pathname.startsWith('/revistas');
const isPesquisa = Astro.url.pathname.startsWith('/pesquisa');
const isNumeros  = Astro.url.pathname === '/numeros';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body data-magazine={magazine ?? undefined}>
  <div class="container">

    <!-- Universal black top bar -->
    <div id="universal-header">
      <nav class="nav-section">
        <a href="/revistas" class={isRevistas ? 'active' : undefined}>revistas</a>
        <a href="/pesquisa" class={isPesquisa ? 'active' : undefined}>pesquisa</a>
        <a href="/sobre">sobre</a>
      </nav>
    </div>

    <!-- Main logo + search header -->
    <div id="site-header" class="clearfix">
      <div class="grid_8 alpha">
        <a href="/revistas" id="site-logo">
          <img src="/vitruvius-logo.png" alt="Vitruvius" width="241" height="56" />
        </a>
      </div>
      <div class="grid_4 omega" id="site-header-right">
        <form id="header-search" action="/pesquisa" method="get" role="search">
          <input type="search" name="q" value={searchQ} placeholder="buscar artigos…" />
          <button type="submit">buscar</button>
        </form>
      </div>
    </div>

    <!-- Revistas nav bar (always visible) -->
    <div id="revistas-nav">
      <div class="rule-one">
        <a href="/revistas">revistas</a>
      </div>
      <ul class="rn-menu">
        <li><a href="/revistas/browse/arquitextos">arquitextos</a></li>
        <li><a href="/revistas/browse/arquiteturismo">arquiteturismo</a></li>
        <li><a href="/revistas/browse/drops">drops</a></li>
        <li><a href="/revistas/browse/minhacidade">minha cidade</a></li>
        <li><a href="/revistas/browse/entrevista">entrevista</a></li>
        <li><a href="/revistas/browse/projetos">projetos</a></li>
        <li><a href="/revistas/browse/resenhasonline">resenhas online</a></li>
      </ul>
    </div>

    <!-- Magazine header with logo (only on magazine-scoped pages) -->
    {magazine && (
      <div id="magazine-header" data-mag={magazine} class="clearfix">
        <div class="grid_8 alpha mag-logo-col">
          <a href={`/revistas/browse/${magazine}`} class="mag-logo-link">
            <img
              src={`/${magazine}-logo.png`}
              alt={magLabel ?? magazine}
              class="mag-logo"
            />
          </a>
        </div>
        <div class="grid_4 omega mag-right">
          {magIssn && (
            <span class="mag-issn">{magLabel} ISSN {magIssn}</span>
          )}
          <form class="mag-search" action="/pesquisa" method="get" role="search">
            <input type="hidden" name="magazine" value={magazine} />
            <input type="text" name="q" placeholder={`buscar em ${magLabel ?? magazine}`} />
            <button type="submit">ok</button>
          </form>
          <nav class="mag-subnav">
            <ul>
              <li>
                <a
                  href={`/revistas/arquivo/${magazine}`}
                  class={Astro.url.pathname === `/revistas/arquivo/${magazine}` ? 'active' : undefined}
                >arquivo</a>
              </li>
              <li>
                <a
                  href={`/revistas/expediente/${magazine}`}
                  class={Astro.url.pathname === `/revistas/expediente/${magazine}` ? 'active' : undefined}
                >expediente</a>
              </li>
              <li>
                <a
                  href={`/revistas/normas/${magazine}`}
                  class={Astro.url.pathname === `/revistas/normas/${magazine}` ? 'active' : undefined}
                >normas</a>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    )}

    <main>
      <slot />
    </main>

    <div id="site-footer">
      <div class="footer-col">
        <div class="footer-brand">vitruvius</div>
        <p>Publicações de arquitetura,<br />urbanismo e design.</p>
        <p style="margin-top:8px;color:#555;">
          © 2000–{new Date().getFullYear()} Vitruvius
        </p>
      </div>
      <div class="footer-col">
        <h4>revistas</h4>
        <ul>
          <li><a href="/revistas/browse/arquitextos">arquitextos</a></li>
          <li><a href="/revistas/browse/arquiteturismo">arquiteturismo</a></li>
          <li><a href="/revistas/browse/drops">drops</a></li>
          <li><a href="/revistas/browse/minhacidade">minha cidade</a></li>
          <li><a href="/revistas/browse/entrevista">entrevista</a></li>
          <li><a href="/revistas/browse/projetos">projetos</a></li>
          <li><a href="/revistas/browse/resenhasonline">resenhas online</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>vitruvius</h4>
        <ul>
          <li><a href="/pesquisa">pesquisa</a></li>
          <li><a href="/sobre">sobre</a></li>
        </ul>
      </div>
    </div>

  </div><!-- /.container -->
  </body>
</html>
