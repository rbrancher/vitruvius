---
import Base from '../../../layouts/Base.astro';
import { getMagazines } from '../../../lib/db';

export async function getStaticPaths() {
  return getMagazines().map(mag => ({
    params: { magazine: mag.title },
  }));
}

const { magazine } = Astro.params;

const LABELS: Record<string, string> = {
  arquitextos:    'arquitextos',
  arquiteturismo: 'arquiteturismo',
  drops:          'drops',
  minhacidade:    'minha cidade',
  entrevista:     'entrevista',
  projetos:       'projetos',
  resenhasonline: 'resenhas online',
};
const magLabel = LABELS[magazine] ?? magazine;

interface ConselhoMember { name: string; institution: string; }

interface ExpedienteData {
  description: string;
  issn: string;
  editors: string;
  email: string;
  website?: string;
  normas?: boolean;
  conselho?: { title: string; members: ConselhoMember[]; };
}

const NORMAS_MAGS = [
  { slug: 'arquitextos',    label: 'em arquitextos' },
  { slug: 'arquiteturismo', label: 'em arquiteturismo' },
  { slug: 'drops',          label: 'em drops' },
  { slug: 'entrevista',     label: 'em entrevista' },
  { slug: 'minhacidade',    label: 'em minha cidade' },
