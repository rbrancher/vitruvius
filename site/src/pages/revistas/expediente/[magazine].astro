const data = EXPEDIENTE[magazine];
const hasConselho = !!data?.conselho;
---

<Base title={`expediente — ${magLabel}`} magazine={magazine}>

    <div class="expediente-page" style="padding: 12px 0 36px;">

      <div class="rule-three rule-three--mag" style="margin-top: 0;">expediente</div>

      {data ? (
        <div class="expediente-body expediente-two-col clearfix">

          <div class="expediente-info">
            <p>{data.description}</p>
            <p>ISSN {data.issn}</p>
            <p>
              <strong>{data.editors.includes(' e ') || data.editors.includes(',') ? 'editores responsáveis' : 'editor responsável'}</strong><br />
              {data.editors}
            </p>
            <p>
              <strong>email de contato</strong><br />
              <a href={`mailto:${data.email}`}>{data.email}</a>
            </p>
            {data.website && (
              <p>
                <strong>endereço eletrônico</strong><br />
                {data.website}
              </p>
            )}
            {data.normas && (
              <p>
                <strong>normas para publicação</strong><br />
                {NORMAS_MAGS.map(m => (
                  <><a href={`/revistas/normas/${m.slug}`}>{m.label}</a><br /></>
                ))}
              </p>
            )}
          </div>

          <div class="expediente-conselho">
            {data.conselho && (
              <>
                <p>
                  <strong>{data.conselho.title}</strong><br />
                  Os membros do Conselho Editorial de Arquitextos, responsáveis pela avaliação dos artigos submetidos pelos autores, são os seguintes:
                </p>
                <ul class="conselho-list">
                  {data.conselho.members.map(m => (
                    <li><strong>{m.name}</strong> {m.institution}</li>
                  ))}
                </ul>
              </>
            )}
          </div>

        </div>
      ) : (
        <p style="color:#999;">Informações não disponíveis.</p>
      )}

    </div>
  </div>
</Base>
