---
import Base from '../../../../../../layouts/Base.astro';
import ArticleGallery from '../../../../../../components/ArticleGallery.astro';
import {
  getMagazines, getEditionsByMagazine, getPublishedArticlesByEdition,
  getArticleWithMeta, getArticleImages, getArticlePages, getArticleTags, getArticleAbstracts,
  authorFullName, type Image,
} from '../../../../../../lib/db';
import { stripHtml, processArticleBody, imageUrl } from '../../../../../../lib/text';

export async function getStaticPaths() {
  const paths = [];
  for (const mag of getMagazines()) {
    for (const ed of getEditionsByMagazine(mag.id)) {
      for (const a of getPublishedArticlesByEdition(ed.id)) {
        const pages = getArticlePages(a.id);
        if (pages.length === 0) continue;
        // pages 2..N (articlepages[0] = page 2, articlepages[N-1] = page N+1)
        for (let i = 0; i < pages.length; i++) {
          paths.push({
            params: {
              magazine: mag.title,
              edition: ed.idx,
              id: String(a.id),
              page: String(i + 2),
            },
          });
        }
      }
    }
  }
  return paths;
}

const { magazine: magazineSlug, edition: editionIdx, id, page } = Astro.params;
const pageNum = Number(page);

const article = getArticleWithMeta(Number(id))!;
const images  = getArticleImages(Number(id));
const allArticlePages = getArticlePages(Number(id));
const tags = getArticleTags(Number(id));
const abstracts = getArticleAbstracts(Number(id));

// Current articlepage (0-indexed: page 2 → index 0)
const articlePage = allArticlePages[pageNum - 2]!;
const totalPages  = allArticlePages.length + 1;

const imageMap = new Map<number, Image>(images.map(img => [img.id, img]));
const pageBodyHtml = processArticleBody(articlePage.text, imageMap);

// Images for this sub-page that are NOT embedded inline
const placeholderIds = new Set(
  [...(articlePage.text ?? '').matchAll(/\{--image:(\d+)--\}/g)].map(m => Number(m[1]))
);
const galleryImages = images.filter(img => !placeholderIds.has(img.id) && img.is_cover === 0);

const siblings = getPublishedArticlesByEdition(article.edition_id)
  .filter(a => a.id !== article.id);

const LABELS: Record<string, string> = {
  arquitextos:    'arquitextos',
  arquiteturismo: 'arquiteturismo',
  drops:          'drops',
  minhacidade:    'minha cidade',
  entrevista:     'entrevista',
  projetos:       'projetos',
  resenhasonline: 'resenhas online',
};
const label = LABELS[magazineSlug] ?? magazineSlug;

const ISSN: Record<string, string> = {
  arquitextos: '1809-6298', arquiteturismo: '1982-9930', drops: '2175-6716',
  minhacidade: '1982-9922', entrevista: '2175-6708', projetos: '2595-4245',
  resenhasonline: '2175-6694',
};

const authorName = (article.author_firstname || article.author_lastname)
  ? authorFullName({ firstname: article.author_firstname, lastname: article.author_lastname })
  : null;

const articleDate = article.created_at ? new Date(article.created_at * 1000) : null;
const publishedYear = articleDate?.getFullYear() ?? null;

const PT_MONTHS = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
const edParts = editionIdx.split('.');
const edYear2 = edParts[0] ?? '';
const edNum3  = edParts[1] ?? '';
const artIdx  = article.idx ?? '00';
const edHeaderLeft = `${edNum3}.${artIdx}${article.section ? ' ' + article.section : ''}`;
const edHeaderRight = articleDate
  ? `ano ${edYear2}, ${PT_MONTHS[articleDate.getMonth()]}. ${articleDate.getFullYear()}`
  : `ed. ${editionIdx}`;

const plainTitle = stripHtml(article.title) || 'Artigo';
const pageTitle  = articlePage.title ? stripHtml(articlePage.title) : `${plainTitle} (${pageNum}/${totalPages})`;

const baseUrl = `/revistas/read/${magazineSlug}/${editionIdx}/${id}`;
const prevUrl = pageNum === 2 ? baseUrl : `${baseUrl}/${pageNum - 1}`;
const nextUrl = pageNum < totalPages ? `${baseUrl}/${pageNum + 1}` : null;
---

<Base
  title={pageTitle}
  description={`${plainTitle} — página ${pageNum} de ${totalPages} — ${label} ${editionIdx}`}
  canonicalUrl={Astro.url.href}
  magazine={magazineSlug}
  editionIdx={editionIdx}
>


    <!-- Edition bar: full width -->
    <div class="rule-three rule-three--mag">
      <a href={`/revistas/browse/${magazineSlug}/${editionIdx}`}>{edHeaderLeft}</a>
      <span class="sep">·</span>
      <span class="ed-info">{edHeaderRight}</span>
    </div>

    <!-- Header row: title/author full meta-data width, no sidebar -->
    <div class="meta-data">
      <div class="grid_9 alpha">
        <header class="article-header">
          <h1>
            <a href={baseUrl} style="text-decoration:none;" set:html={article.title} />
          </h1>

          {articlePage.title && articlePage.title !== article.title && (
            <h2 set:html={articlePage.title} />
          )}

          {(articlePage.location || articlePage.date) && (
            <div class="ah-institution">
              {articlePage.location}{articlePage.location && articlePage.date ? ' · ' : ''}{articlePage.date}
            </div>
          )}

          {authorName && (
            <div class="ah-author">
              {article.author_slug
                ? <a href={`/autor/${article.author_slug}`}>{authorName}</a>
                : authorName}
            </div>
          )}
        </header>
      </div>
    </div>

    <!-- Content row -->
    <div class="article-page clearfix">

      <div class="grid_9 alpha">

        {abstracts.length > 0 && (
          <div class="abstracts">
            <h3 class="rule-four">sinopses</h3>
            {abstracts.map(ab => (
              <p><strong>{ab.label}</strong><br />{ab.abstract}</p>
            ))}
          </div>
        )}

        <div class="how_to_cit">
          <h3 class="rule-four">como citar</h3>
          <p class="cite-text">
            {authorName ? `${authorName}. ` : ''}
            &ldquo;<span set:html={article.title} />&rdquo;.
            <em>Vitruvius {label}</em>, ed. {editionIdx}.{publishedYear && ` ${publishedYear}.`}
            Disponível em: {new URL(baseUrl, Astro.url).href}
          </p>
        </div>

        {galleryImages.length > 1 && (
          <ArticleGallery images={galleryImages} />
        )}

        <nav class="page-nav">
          <a class="page-nav__prev" href={prevUrl}>← página anterior</a>
          <span class="page-nav__label">página {pageNum} de {totalPages}</span>
          {nextUrl
            ? <a class="page-nav__next" href={nextUrl}>próxima página →</a>
            : <span class="page-nav__next" style="color:#ccc;">fim do artigo</span>
          }
        </nav>

        <div class="article-body" set:html={pageBodyHtml} />

        <nav class="page-nav">
          <a class="page-nav__prev" href={prevUrl}>← página anterior</a>
          <span class="page-nav__label">página {pageNum} de {totalPages}</span>
          {nextUrl
            ? <a class="page-nav__next" href={nextUrl}>próxima página →</a>
            : <span class="page-nav__next" style="color:#ccc;">fim do artigo</span>
          }
        </nav>

        {tags.length > 0 && pageNum === totalPages && (
          <div class="tags" style="margin-top:16px;">
            {tags.map(t => (
              <a class="tag" href={`/pesquisa?tag=${t.id}`}>{t.title}</a>
            ))}
          </div>
        )}
      </div>

      <!-- Sidebar: grid_3 omega -->
      <div class="grid_3 omega article-sidebar">
        <div class="service">

          <div class="rule-three rule-three--mag">
            {edHeaderLeft}
            <span class="info">
              <br /><a href="javascript://" class="abstracts_trigger">sinopse</a>
              <br /><a href="javascript://" class="citation_trigger">como citar</a>
            </span>
          </div>

          <!-- Page index -->
          <div class="rule-three rule-three--mag" style="margin-top:12px;">páginas</div>
          <div class="entry">
            <h3 class="index">1</h3>
            <h2>
              <a href={baseUrl} style={pageNum === 1 ? 'font-weight:bold;' : ''}
                 set:html={article.title} />
            </h2>
          </div>
          {allArticlePages.map((pg, i) => (
            <div class="entry">
              <h3 class="index">{i + 2}</h3>
              <h2>
                <a href={`${baseUrl}/${i + 2}`}
                   style={pageNum === i + 2 ? 'font-weight:bold;' : ''}>
                  {pg.title ? <span set:html={pg.title} /> : `página ${i + 2}`}
                </a>
              </h2>
            </div>
          ))}

          <div class="rule-three rule-three--mag" style="margin-top:12px;">
            <a href={`/revistas/browse/${magazineSlug}/${editionIdx}`}>edição {editionIdx}</a>
          </div>

          {siblings.map(s => (
            <div class="entry">
              <h3 class="index">{edNum3}.{s.idx}{s.section ? ` ${s.section}` : ''}</h3>
              <h2>
                <a href={`/revistas/read/${magazineSlug}/${editionIdx}/${s.id}`}
                   set:html={s.title} />
              </h2>
              {s.subtitle && <h2 class="subtitle" set:html={s.subtitle} />}
              {(s.author_firstname || s.author_lastname) && (
                <h3 class="author">
                  {authorFullName({ firstname: s.author_firstname, lastname: s.author_lastname })}
                </h3>
              )}
            </div>
          ))}

        </div>
      </div>

    </div><!-- /.article-page -->
  </div>

  <script>
    document.querySelector('.abstracts_trigger')?.addEventListener('click', e => {
      e.preventDefault();
      document.querySelector('.abstracts')?.classList.toggle('visible');
    });
    document.querySelector('.citation_trigger')?.addEventListener('click', e => {
      e.preventDefault();
      document.querySelector('.how_to_cit')?.classList.toggle('visible');
    });
  </script>
</Base>
